@using Nop.Core.Domain.Catalog
@using Nop.Services.Helpers

@inject CatalogSettings catalogSettings
@inject IThemeContext themeContext
@inject IUserAgentHelper userAgentHelper

@{
    Layout ="";
    var themeName = await themeContext.GetWorkingThemeNameAsync();
    var supportRtl = await Html.ShouldUseRtlThemeAsync();

    //add main CSS file
    NopHtml.AppendCssFileParts($"~/Themes/{themeName}/Content/css/styles{(supportRtl ? ".rtl" : "")}.css");
    
    //add swiper css file
    if (catalogSettings.DisplayAllPicturesOnCatalogPages)
    {
        NopHtml.AppendCssFileParts("~/lib_npm/swiper/swiper-bundle.min.css");
    }

    //add jQuery UI css file
    NopHtml.AppendCssFileParts("~/lib_npm/jquery-ui-dist/jquery-ui.min.css");
}

<script asp-location="Footer">
    // SIDEBAR ACCORDION / MOBILE OVERLAY
    // Desktop (>= 1001px) : clicking a section title expands/collapses its
    //                       content in place (accordion).
    // Mobile (< 1001px)   : every section (product filters + blocks) is a
    //                       chip in the top row; clicking opens the content
    //                       as a bottom-sheet overlay over the page. It is
    //                       closed via the X button, the dimmed backdrop,
    //                       or the Escape key.
    // Everything is bound with event delegation, so clicks keep working
    // after Ajax re-renders the sidebar.
    $(function() {
        var isMobile = function () {
            var e = window, a = 'inner';
            if (!('innerWidth' in window)) {
                a = 'client';
                e = document.documentElement || document.body;
            }
            return e[a + 'Width'] < 1001;
        };

        var $backdrop = $('<div class="sidebar-overlay-backdrop"></div>').appendTo('body').hide();
        var $open = null;

        // The opened content is appended to <body> (portal-style) instead of
        // staying inside .side-2, because some browsers fail to honour
        // position: fixed for descendants of a display:contents element inside
        // the .side-2 scroll container (the sheet then renders inline in the
        // chip row and the backdrop covers it). As a body child in the root
        // stacking context, sheet and backdrop always layer correctly.
        // The open/close motion is driven by jQuery with an explicit, identical
        // duration for every sheet, so content size no longer affects speed.
        var closeOverlay = function () {
            if ($open) {
                var $origin = $open.data('overlay-origin') || null;
                $open.removeData('overlay-origin');
                $open.children('.overlay-head').remove();
                $open.removeClass('overlay-open');
                $open.removeAttr('style');
                if ($origin && $origin.length) $origin.append($open);
                if ($open.hasClass('product-sorting-overlay')) $open.remove();
                $open = null;
            }
            $backdrop.stop(true, true).animate({ opacity: 0 }, 120, function () {
                $(this).hide();
            });
            $('body').removeClass('sidebar-overlay-open');
        };

        var openOverlay = function ($content) {
            closeOverlay();
            $content.data('overlay-origin', $content.parent());
            var $titleEl = $content.closest('.product-filter').children('.filter-title').first();
            if (!$titleEl.length) $titleEl = $content.closest('.block').children('.title').first();
            var label = $.trim($titleEl.text());
            var $head = $('<div class="overlay-head"></div>');
            if (label) $head.append($('<span class="overlay-head-title"></span>').text(label));
            $head.append($('<button type="button" class="overlay-close" aria-label="close">×</button>'));
            $head.prependTo($content);
            $content.addClass('overlay-open');
            $('body').append($content);
            $content.scrollTop(0);
            $open = $content;
            $backdrop.stop(true, true).css({ display: 'block', opacity: 0 }).animate({ opacity: 1 }, 180);
            $content.stop(true, true)
                .css({ opacity: 0 })
                .animate({ opacity: 1 }, 180);
            $('body').addClass('sidebar-overlay-open');
        };

        $backdrop.on('click', closeOverlay);
        $(document).on('click', '.overlay-close', closeOverlay);
        $(document).on('keyup', function (e) {
            if (e.key === 'Escape') closeOverlay();
        });

        // sidebar blocks (categories, manufacturers, popular tags, recently viewed)
        $(document).on('click', '.side-2 .block > .title', function () {
            var $title = $(this);
            var $block = $title.closest('.block');
            var $listbox = $block.children('.listbox').first();
            if ($listbox.length === 0) return;

            if (isMobile()) {
                if ($listbox.hasClass('overlay-open')) {
                    closeOverlay();
                    return;
                }
                openOverlay($listbox);
                return;
            }

            var isOpen = $listbox.is(':visible');
            $listbox.stop(true, true).slideToggle(220);
            $block.toggleClass('closed', isOpen);
            $title.attr('aria-expanded', isOpen ? 'false' : 'true');
        });

        // product filter boxes (price, specifications, manufacturers)
        $(document).on('click', '.side-2 .product-filter .filter-title', function () {
            var $title = $(this);
            var $filter = $title.closest('.product-filter');
            var $content = $filter.children('.filter-content').first();
            if ($content.length === 0) return;

            if (isMobile()) {
                if ($content.hasClass('overlay-open')) {
                    closeOverlay();
                    return;
                }
                openOverlay($content);
                return;
            }

            var isOpen = $content.is(':visible');
            $content.stop(true, true).slideToggle(220);
            $filter.toggleClass('closed', isOpen);
            $title.attr('aria-expanded', isOpen ? 'false' : 'true');
        });

        // keyboard support: chips/titles behave like buttons
        $(document).on('keydown', '.side-2 .block > .title, .side-2 .product-filter .filter-title', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                $(this).trigger('click');
            }
        });

        // SORT-BY (mobile): the sort chip opens a bottom-sheet overlay listing
        // the options of #products-orderby (same pattern as the filters).
        var decorateSortChip = function () {
            if (!isMobile()) return;
            $('.product-sorting').each(function () {
                var $s = $(this);
                if ($s.find('.sortby-current').length) return;
                var $select = $s.find('select');
                if (!$select.length) return;
                $s.find('.orderby-chips').remove();
                $s.append('<span class="sortby-current"></span><span class="sortby-chev" aria-hidden="true"></span>');
            });
            $('.product-sorting .sortby-current').text(
                $('#products-orderby option:selected').text() || ''
            );
        };

        // Desktop: every sort option becomes a chip in a row above the
        // products; the selected one is highlighted. Selection still goes
        // through #products-orderby so the AJAX flow stays unchanged.
        var decorateSortDesktop = function () {
            if (isMobile()) return;
            var $s = $('.product-sorting').first();
            if (!$s.length) return;
            if ($s.find('.orderby-chips').length) return;
            var $select = $s.find('select');
            if (!$select.length) return;
            $s.find('.sortby-current, .sortby-chev').remove();
            var $chips = $('<div class="orderby-chips"></div>');
            $select.find('option').each(function () {
                $('<button type="button" class="orderby-chip"></button>')
                    .attr('data-value', this.value)
                    .addClass(this.selected ? 'selected' : '')
                    .text($(this).text())
                    .appendTo($chips);
            });
            $s.append($chips);
            $select.hide();
        };

        // Mobile: live in the FILTERS CHIP ROW (first position) instead of a
        // separate bar. Desktop: back inside .product-selectors.
        var relocateSortChip = function () {
            var $s = $('.product-sorting').not('.side-2 .product-sorting').first();
            if (!$s.length) return;
            if (isMobile()) {
                $('.side-2 > .product-sorting').remove();
                $('.side-2').first().prepend($s);
                var $sel = $('.product-selectors').first();
                if ($sel.length) {
                    var hasVisible = $sel.children().filter(function () { return $(this).is(':visible'); }).length > 0;
                    $sel.toggle(hasVisible);
                }
            } else if ($s.closest('.side-2').length) {
                var $sel = $('.product-selectors').first();
                if ($sel.length) {
                    $s.appendTo($sel);
                    $sel.show();
                }
            }
        };

        // Applies the right UI for the CURRENT viewport: mobile keeps the
        // sort chip (in the filters row + bottom-sheet overlay), desktop
        // renders every option as a chip row. Re-run on resize and after Ajax.
        var applyResponsiveSort = function () {
            if (isMobile()) {
                decorateSortChip();
                relocateSortChip();
            } else {
                relocateSortChip();
                decorateSortDesktop();
            }
        };

        var openSortOverlay = function () {
            var $select = $('#products-orderby');
            if (!$select.length) return;
            closeOverlay();
            $('.product-sorting-overlay').remove();
            var label = $.trim($('.product-sorting > span').first().text());
            if (!label) label = 'Sort by';
            var $ov = $('<div class="filter-content product-sorting-overlay"></div>');
            $('<div class="overlay-head"></div>')
                .append($('<span class="overlay-head-title"></span>').text(label))
                .append('<button type="button" class="overlay-close" aria-label="close">×</button>')
                .prependTo($ov);
            var $ul = $('<ul class="sortby-options"></ul>');
            $select.find('option').each(function () {
                $('<li></li>')
                    .attr('data-value', this.value)
                    .addClass(this.selected ? 'selected' : '')
                    .text($(this).text())
                    .appendTo($ul);
            });
            $ov.append($ul);
            $('body').append($ov);
            $ov.addClass('overlay-open');
            $ov.scrollTop(0);
            $open = $ov;
            $backdrop.stop(true, true).css({ display: 'block', opacity: 0 }).animate({ opacity: 1 }, 180);
            $ov.stop(true, true).css({ opacity: 0 }).animate({ opacity: 1 }, 180);
            $('body').addClass('sidebar-overlay-open');
        };

        $(document).on('click', '.product-sorting', function (e) {
            if (!isMobile()) return;
            e.preventDefault();
            decorateSortChip();
            openSortOverlay();
        });

        $(document).on('keydown', '.product-sorting', function (e) {
            if (!isMobile()) return;
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                $(this).trigger('click');
            }
        });

        $(document).on('click', '.sortby-options li', function () {
            var $select = $('#products-orderby');
            if ($select.length && !$(this).hasClass('selected')) {
                $select.val($(this).data('value')).trigger('change');
            }
            closeOverlay();
        });

        $(document).on('click', '.orderby-chip', function () {
            var $select = $('#products-orderby');
            if ($select.length && !$(this).hasClass('selected')) {
                $select.val($(this).data('value')).trigger('change');
            }
        });

        if (window.CatalogProducts) {
            $(CatalogProducts).on('loaded', applyResponsiveSort);
        }

        var resizeTimer;
        $(window).on('resize', function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(applyResponsiveSort, 150);
        });

        // Desktop accordion starts with every section collapsed;
        // mobile keeps the chips row (content is hidden via CSS anyway).
        if (!isMobile()) {
            $('.side-2 .block').addClass('closed');
            $('.side-2 .product-filter').addClass('closed');
            $('.side-2 .block .listbox, .side-2 .product-filter .filter-content').hide();
        }

        $('.side-2 .block > .title, .side-2 .product-filter .filter-title')
            .attr('tabindex', '0')
            .attr('role', 'button')
            .attr('aria-expanded', 'false');

        applyResponsiveSort();
    });
</script>